datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

model User {
  id               String               @id @default(uuid())
  email            String               @unique
  passwordHash     String
  name             String
  createdAt        DateTime             @default(now())
  
  // Relations
  groupsCreated    Group[]              @relation("GroupCreator")
  groupMemberships GroupMember[]
  expensesPaid     Expense[]
  splitsOwed       ExpenseParticipant[]
  settlementsPaid  Settlement[]         @relation("SettlementPayer")
  settlementsRcvd  Settlement[]         @relation("SettlementPayee")
  activityLogs     ActivityLog[]
  comments         Comment[]
}

model Group {
  id               String               @id @default(uuid())
  name             String
  createdById      String
  createdAt        DateTime             @default(now())
  
  // Relations
  createdBy        User                 @relation("GroupCreator", fields: [createdById], references: [id])
  members          GroupMember[]
  expenses         Expense[]
  settlements      Settlement[]
  activityLogs     ActivityLog[]
}

model GroupMember {
  id               String               @id @default(uuid())
  userId           String
  groupId          String
  joinedAt         DateTime             @default(now())
  
  // Relations
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  group            Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

enum SplitType {
  EQUAL
  UNEQUAL
  PERCENTAGE
  SHARE
}

model Expense {
  id               String               @id @default(uuid())
  groupId          String
  description      String
  amountInPaise    Int                  // Stored in Paisa
  paidById         String
  splitType        SplitType
  deletedAt        DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  
  // Relations
  group            Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy           User                 @relation(fields: [paidById], references: [id])
  participants     ExpenseParticipant[]
  comments         Comment[]

  @@index([groupId])
}

model ExpenseParticipant {
  id               String               @id @default(uuid())
  expenseId        String
  userId           String
  splitValue       Int?                 // Optional depending on type (e.g. 2000 for 20.00%)
  amountInPaise    Int                  // Stored in Paisa
  
  // Relations
  expense          Expense              @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user             User                 @relation(fields: [userId], references: [id])

  @@unique([expenseId, userId])
  @@index([expenseId])
}

model Settlement {
  id               String               @id @default(uuid())
  groupId          String
  payerId          String
  payeeId          String
  amountInPaise    Int                  // Stored in Paisa
  createdAt        DateTime             @default(now())
  
  // Relations
  group            Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer            User                 @relation("SettlementPayer", fields: [payerId], references: [id])
  payee            User                 @relation("SettlementPayee", fields: [payeeId], references: [id])

  @@index([groupId])
}

enum ActivityType {
  CREATE_EXPENSE
  EDIT_EXPENSE
  DELETE_EXPENSE
  SETTLE
  COMMENT_ADDED
}

model ActivityLog {
  id               String               @id @default(uuid())
  groupId          String
  userId           String
  type             ActivityType
  payload          Json
  createdAt        DateTime             @default(now())
  
  // Relations
  group            Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user             User                 @relation(fields: [userId], references: [id])

  @@index([groupId])
}

model Comment {
  id               String               @id @default(uuid())
  expenseId        String
  userId           String
  text             String
  deletedAt        DateTime?
  createdAt        DateTime             @default(now())
  
  // Relations
  expense          Expense              @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user             User                 @relation(fields: [userId], references: [id])

  @@index([expenseId])
}
